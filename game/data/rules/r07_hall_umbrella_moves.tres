[gd_resource type="Resource" script_class="HouseRule" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/house_rule.gd" id="1_houserule"]

[resource]
script = ExtResource("1_houserule")
id = &"r07_hall_umbrella_moves"
trigger = "room_left"
trigger_param = "hall"
condition = "!item_checked:hall_umbrella_stand && checked>=8"
actions = Array[String](["move_item:hall_umbrella_stand:hall:hall_anchor_console", "attention:+4"])
once = true
cooldown = 0.0
