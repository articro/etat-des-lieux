[gd_resource type="Resource" script_class="HouseRule" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/house_rule.gd" id="1_houserule"]

[resource]
script = ExtResource("1_houserule")
id = &"r11_key_to_preserves"
trigger = "room_entered"
trigger_param = "kitchen"
condition = "doc_read:kitchen_letter_lucienne_1 && !item_checked:kitchen_key_l"
