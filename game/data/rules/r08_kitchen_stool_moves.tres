[gd_resource type="Resource" script_class="HouseRule" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/house_rule.gd" id="1_houserule"]

[resource]
script = ExtResource("1_houserule")
id = &"r08_kitchen_stool_moves"
trigger = "room_left"
trigger_param = "kitchen"
condition = "!item_checked:kitchen_stool && checked>=10"
actions = Array[String](["move_item:kitchen_stool:kitchen:kitchen_anchor_sink", "attention:+4"])
once = true
cooldown = 0.0
